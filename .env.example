# Neon Postgres connection string. When set, the app persists to Neon instead
# of the local JSON file. Get this from your Neon project dashboard
# (Connection Details -> "Pooled connection" recommended for serverless).
# Copy this file to .env and fill in your real value. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Optional server config (defaults shown).
# PORT=3000
# HOST=0.0.0.0
# SWEEPSTAKE_DATA_FILE=./data/sweepstake.json

# Bearer token required by the Vercel serverless API. Every request must send
# `Authorization: Bearer <API_TOKEN>`. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset on the deployment, the API fails closed (refuses all requests).
API_TOKEN="replace-with-a-long-random-secret"
