# Neon Postgres connection string. When set, the app persists to Neon instead
# of the local JSON file. Get this from your Neon project dashboard
# (Connection Details -> "Pooled connection" recommended for serverless).
# Copy this file to .env and fill in your real value. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Optional server config (defaults shown).
# PORT=3000
# HOST=0.0.0.0
# SWEEPSTAKE_DATA_FILE=./data/sweepstake.json

# Bearer token for scripts (seed/migrate) and as an alternative admin auth.
# Every write also accepts the admin session cookie set via password login.
API_TOKEN="replace-with-a-long-random-secret"

# Admin password for the web admin login (friendlier than pasting the token).
# Set this in Vercel too. If unset, admin login is disabled (fails closed).
ADMIN_PASSWORD="choose-a-strong-admin-password"

# Optional: secret used to sign session cookies. Falls back to API_TOKEN if unset.
# SESSION_SECRET="another-long-random-secret"
